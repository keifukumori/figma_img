FIGMA_API_TOKEN=your_figma_token_here

# Offline input (PC only)
INPUT_JSON_FILE=figma_layout/raw_figma_data/latest_pc.json
FRAME_NODE_ID=1:2
OFFLINE_MODE=true
IMAGE_SOURCE=local
USE_IMAGES=true

# Device mode: pc | sp | both
DEVICE_MODE=pc

# Output options
OUTPUT_DIR=figma_layout
PC_SUFFIX=-pc
SP_SUFFIX=-sp
SINGLE_HTML=true
SINGLE_HTML_ONLY=true
# Optional: generate single DOM (PC DOM only; SP CSS under media query)
# SINGLE_DOM=false

# Optional exclusions
EXCLUDE_HEADER_FOOTER=true
EXCLUDE_LAYER_NAMES=footer,フッター,header,ヘッダー,nav,breadcrumb,include,inc,partial,shared

# Style scope and safety
NODE_STYLE_SCOPE=conservative
SUPPRESS_CONTAINER_WIDTH=true
SUPPRESS_FIXED_HEIGHT=true
USE_ASPECT_RATIO=true
SECTION_WRAPPER_MODE=compact

# Alias mapping (safe defaults)
N_CLASS_ALIAS_MODE=add
N_CLASS_ALIAS_SOURCE=semantic
N_CLASS_ALIAS_NAMESPACE=section
N_CLASS_ALIAS_STYLE=bem
N_CLASS_ALIAS_DEDUP=none
N_CLASS_ALIAS_UNIQUE_ONLY=true
N_CLASS_ALIAS_DROP_N_UNIQUE=true

# Typography tokens
# off | role | section_local
TEXT_TOKEN_MODE=section_local
# When section_local: control token shapes
TEXT_LOCAL_BASE=text
TEXT_LOCAL_NOTE_BASE=note
TEXT_LOCAL_ENUM_WIDTH=2
TEXT_LOCAL_INCLUDE_HN=true
# Figma style tokens control
FIGMA_STYLE_HTML=false
FIGMA_STYLE_CSS=false
# When true, fallback text-size-* classes include color. Set false to keep color on per-node .n-* only.
# This prevents shared aliases or common classes from propagating instance text color (e.g., many whites).
# FALLBACK_TEXT_CLASS_INCLUDE_COLOR=false
# Use underscore for section alias token joiner (about__men_s_tbc)
N_CLASS_ALIAS_TOKEN_JOINER=_

# n-* visual-only (no layout props on non-text nodes)
N_NODE_VISUAL_ONLY=true

# --- Optional post steps (pipeline) ---
# POSTPROCESS_UNIFY=false
# POSTPROCESS_COMMON=false
# POSTPROCESS_COMPONENTS=false

# --- Optional ops after build (section-scoped) ---
# POST_OPS_ASSIGN_SECTIONS=false
# POST_OPS_ADD_SECTION_ROW_ALIAS=false
# POST_OPS_ADD_SECTION_CARD_ALIAS=false
# POST_OPS_PROMOTE_SHADOW_TO_ROW_ITEM=false
# POST_OPS_ENSURE_STYLE_ORDER=false
# POST_OPS_ESCALATE_ALIAS_SPECIFICITY=false
# POST_OPS_MIRROR_N_SELECTORS=false
# POST_OPS_ALIAS_GRAFT=false
# POST_OPS_REPORT_N_BLOCKERS=false
# POST_OPS_PROPOSE_SECTION_BREAKS=false
# POST_OPS_APPLY_SECTION_BREAKS=false
# POST_OPS_SECTION_BREAK_REASONS=heading,typography,background,rule
# POST_OPS_SECTION_BREAK_ENUM_WIDTH=2
# POST_OPS_NEUTRALIZE_N_SECTION=
# POST_OPS_DROP_N_IF_COVERED=false
# POST_OPS_DROP_N_STRICT=true
# POST_OPS_ALLOW_MEDIA_LAYOUT=true
# POST_OPS_ALLOW_COMPLEX_LAYOUT=true
# POST_OPS_PRUNE_UNUSED_N_CSS=true
# POST_OPS_BACKUP=false
